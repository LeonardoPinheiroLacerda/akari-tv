{
  "name": "akari-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "tsc -b --noEmit && eslint .",
    "api:gen": "orval --config orval.config.ts",
    "api:check": "orval --config orval.config.ts && git diff --exit-code -- src/api/generated",
    "android:add": "cap add android",
    "android:sync": "vite build && cap sync android",
    "android:run": "vite build && cap run android"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.1",
    "@noriginmedia/norigin-spatial-navigation": "3.4.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.22",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "hls.js": "1.7.3",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "msw": "3.0.3",
    "orval": "8.44.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
